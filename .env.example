# ==========================================
# BLOOMBERG TERMINAL AI - ENV EXAMPLE
# ==========================================

APP_NAME="Bloomberg Terminal AI Backend"
VERSION="1.0.0"
DEBUG=true

# Database & Redis
DATABASE_URL="postgresql://postgres:password@localhost:5432/bloomberg_terminal"
REDIS_URL="redis://localhost:6379"

# Market APIs
FMP_API_KEY="your_fmp_api_key_here"
POLYGON_API_KEY="your_polygon_api_key_here"
SEC_USER_AGENT="YourName user@domain.com"

# Public Live Flight Radar APIs (OpenSky Network - Free Public API)
OPENSKY_USERNAME="your_opensky_username_optional"
OPENSKY_PASSWORD="your_opensky_password_optional"
AIRLABS_API_KEY="your_airlabs_api_key_optional"

# Public Live AIS Vessel APIs
VESSEL_TRACKER_API_KEY="your_vessel_tracker_key_optional"
MYSHIPTRACKING_API_KEY="your_myshiptracking_key_optional"

# AI / LLM Keys
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
