# ==========================================
# BLOOMBERG TERMINAL AI - ENV CONFIG EXAMPLE
# ==========================================

# Core Application Settings
APP_NAME="Bloomberg Terminal AI Backend"
VERSION="1.0.0"
DEBUG=true

# Database Credentials (PostgreSQL + pgvector extension)
DATABASE_URL="postgresql://postgres:password@localhost:5432/bloomberg_terminal"

# Redis Streams & Cache Connection String
REDIS_URL="redis://localhost:6379"

# SEC EDGAR User-Agent (Required by SEC.gov data endpoint)
SEC_USER_AGENT="BloombergTerminalAI admin@bloomberg-ai.dev"

# Market & Financial Data APIs (Optional - fallbacks to built-in feeds if empty)
FMP_API_KEY="your_financial_modeling_prep_key_optional"
POLYGON_API_KEY="your_polygon_io_key_optional"
FINNHUB_API_KEY="your_finnhub_key_optional"

# Public Live Flight Radar APIs (OpenSky Network - FREE Public API out of the box!)
OPENSKY_USERNAME="your_opensky_username_optional"
OPENSKY_PASSWORD="your_opensky_password_optional"
AIRLABS_API_KEY="your_airlabs_api_key_optional"
AVIATIONSTACK_API_KEY="your_aviationstack_api_key_optional"

# Public Live AIS Vessel & Maritime Tracking APIs
VESSEL_TRACKER_API_KEY="your_vessel_tracker_key_optional"
MYSHIPTRACKING_API_KEY="your_myshiptracking_key_optional"

# AI & LLM Provider API Keys (Optional - fallbacks to local state machine if empty)
GEMINI_API_KEY="your_gemini_api_key_optional"
OPENAI_API_KEY="your_openai_api_key_optional"
ANTHROPIC_API_KEY="your_anthropic_api_key_optional"

# Financial News API Key (Optional)
NEWS_API_KEY="your_news_api_key_optional"
