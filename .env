# ==========================================
# BLOOMBERG TERMINAL AI - ENVIRONMENT CONFIG
# ==========================================

# Core App Config
APP_NAME="Bloomberg Terminal AI Backend"
VERSION="1.0.0"
DEBUG=true

# Database Credentials (PostgreSQL + pgvector)
# Replace with your actual PostgreSQL connection string if running external DB
DATABASE_URL="postgresql://postgres:password@localhost:5432/bloomberg_terminal"

# Redis Credentials (Redis & Redis Streams)
REDIS_URL="redis://localhost:6379"

# External Market Data API Keys (Optional - fallbacks to built-in feeds if empty)
FMP_API_KEY=""
POLYGON_API_KEY=""
FINNHUB_API_KEY=""

# SEC EDGAR User-Agent (Required by data.sec.gov)
SEC_USER_AGENT="BloombergTerminalAI admin@bloomberg-ai.dev"

# AI & LLM Provider API Keys (Optional - fallbacks to local state machine if empty)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Financial News API Key (Optional)
NEWS_API_KEY=""
