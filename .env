# ==========================================
# BLOOMBERG TERMINAL AI - ENVIRONMENT CONFIG
# ==========================================

# Core App Config
APP_NAME="Bloomberg Terminal AI Backend"
VERSION="1.0.0"
DEBUG=true

# Database Credentials (PostgreSQL + pgvector)
DATABASE_URL="postgresql://postgres:password@localhost:5432/bloomberg_terminal"

# Redis Credentials (Redis & Redis Streams)
REDIS_URL="redis://localhost:6379"

# External Market Data API Keys
FMP_API_KEY=""
POLYGON_API_KEY=""
FINNHUB_API_KEY=""
SEC_USER_AGENT="BloombergTerminalAI admin@bloomberg-ai.dev"

# Public Live Flight Radar APIs (OpenSky Network is FREE out of the box!)
OPENSKY_USERNAME=""
OPENSKY_PASSWORD=""
AIRLABS_API_KEY=""
AVIATIONSTACK_API_KEY=""

# Public Live AIS Vessel & Maritime Tracking APIs
VESSEL_TRACKER_API_KEY=""
MYSHIPTRACKING_API_KEY=""

# AI & LLM Provider API Keys
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Financial News API Key
NEWS_API_KEY=""
